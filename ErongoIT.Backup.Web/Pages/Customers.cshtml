@page
@model CustomersModel

@{
    ViewData["Title"] = "Customers";
}

<div class="page-header">
    <div>
        <div class="eyebrow">ERONGOIT BACKUP</div>
        <h1>Customers</h1>
        <p class="page-description">
            Manage customers using the ErongoIT backup service.
        </p>
    </div>

    <div class="api-status">
        <span class="status-dot @(Model.Health?.Status == "Healthy" ? "online" : "offline")"></span>
        <span>
            API
            <strong>
                @(Model.Health?.Status ?? "Unavailable")
            </strong>
        </span>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success dashboard-alert">
        @successMessage
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger dashboard-alert">
        @errorMessage
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger dashboard-alert">
        <strong>Unable to complete the request.</strong>

        <ul>
        @foreach (var error in ViewData.ModelState.Values
            .SelectMany(x => x.Errors))
        {
            <li>@error.ErrorMessage</li>
        }
        </ul>
    </div>
}

<section class="panel customer-create-panel">
    <div class="panel-header">
        <div>
            <h2>Add Customer</h2>
            <p>Create a new customer for the backup service.</p>
        </div>
    </div>

    <form method="post"
          asp-page-handler="Create"
          class="customer-form">

        <div class="customer-form-field">
            <label asp-for="CreateCustomer.Name">
                Customer Name
            </label>

            <input asp-for="CreateCustomer.Name"
                   class="form-control"
                   placeholder="Customer name"
                   autocomplete="organization" />
        </div>

        <div class="customer-form-field">
            <label asp-for="CreateCustomer.ContactEmail">
                Contact Email
            </label>

            <input asp-for="CreateCustomer.ContactEmail"
                   class="form-control"
                   placeholder="email@example.com"
                   type="email"
                   autocomplete="email" />
        </div>

        <div class="customer-form-action">
            <button type="submit"
                    class="btn btn-primary">
                Add Customer
            </button>
        </div>
    </form>
</section>

<section class="panel">
    <div class="panel-header">
        <div>
            <h2>Configured Customers</h2>
            <p>Customers currently registered with the backup server.</p>
        </div>

        <span class="badge badge-muted">
            @Model.Customers.Count customer@(Model.Customers.Count == 1 ? "" : "s")
        </span>
    </div>

    @if (Model.Customers.Count == 0)
    {
        <div class="empty-state">
            No customers found.
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="customers-table">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Contact Email</th>
                        <th>Status</th>
                        <th>Customer ID</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                @foreach (var customer in Model.Customers)
                {
                    <tr>
                        <td>
                            <strong>@customer.Name</strong>
                        </td>

                        <td>
                            <form method="post"
                                  asp-page-handler="UpdateEmail"
                                  class="inline-edit-form">

                                <input type="hidden"
                                       name="EditCustomer.CustomerId"
                                       value="@customer.Id" />

                                <input type="email"
                                       name="EditCustomer.ContactEmail"
                                       value="@customer.ContactEmail"
                                       class="form-control form-control-sm"
                                       placeholder="No email configured" />

                                <button type="submit"
                                        class="btn btn-sm btn-outline-primary">
                                    Save
                                </button>
                            </form>
                        </td>

                        <td>
                            <span class="badge @(customer.IsActive
                                ? "badge-success"
                                : "badge-muted")">
                                @(customer.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>

                        <td>
                            <small>@customer.Id</small>
                        </td>

                        <td>
                            <div class="customer-actions">
                                @if (customer.IsActive)
                                {
                                    <form method="post"
                                          asp-page-handler="Deactivate">

                                        <input type="hidden"
                                               name="customerId"
                                               value="@customer.Id" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Deactivate
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post"
                                          asp-page-handler="Activate">

                                        <input type="hidden"
                                               name="customerId"
                                               value="@customer.Id" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-success">
                                            Activate
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
