<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ErongoIT Backup</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" asp-page="/Index">
                <img class="brand-logo"
                     src="~/images/eitc-logo.png"
                     alt="ErongoIT" />

                <div>
                    <strong>ErongoIT</strong>
                    <span>Backup</span>
                </div>
            </a>

            <nav class="navigation">
                <div class="nav-section">MONITORING</div>

                <a class="nav-link @(Context.Request.Path == "/" ? "active" : "")"
                   asp-page="/Index">
                    <span class="nav-icon">▦</span>
                    Dashboard
                </a>

                <div class="nav-section">MANAGEMENT</div>

                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Customers") ? "active" : "")"
                   asp-page="/Customers">
                    <span class="nav-icon">◉</span>
                    Customers
                </a>

                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Devices") ? "active" : "")"
                   asp-page="/Devices">
                    <span class="nav-icon">▣</span>
                    Devices
                </a>

                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/BackupPlans") ? "active" : "")"
                   asp-page="/BackupPlans">
                    <span class="nav-icon">↻</span>
                    Backup Plans
                </a>

                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/BackupJobs") ? "active" : "")"
                   asp-page="/BackupJobs">
                    <span class="nav-icon">▤</span>
                    Backup Jobs
                </a>

                <a class="nav-link" href="#">
                    <span class="nav-icon">◫</span>
                    Restore Points
                </a>

                <div class="nav-section">SYSTEM</div>

                <a class="nav-link" href="#">
                    <span class="nav-icon">◌</span>
                    Storage
                </a>

                <a class="nav-link" href="#">
                    <span class="nav-icon">⚙</span>
                    Settings
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="system-indicator">
                    <span class="status-dot @(Context.Request.Path == "/" ? "online" : "offline")"></span>

                    <div>
                        <strong>Backup Server</strong>
                        <span>Local management</span>
                    </div>
                </div>
            </div>
        </aside>

        <main class="main-content">
            <header class="topbar">
                <div class="breadcrumb">
                    ErongoIT Backup
                    <span>/</span>
                    @ViewData["Title"]
                </div>

                <div class="topbar-right">
                    <span class="environment-badge">DEVELOPMENT</span>
                </div>
            </header>

            <div class="content-container">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
