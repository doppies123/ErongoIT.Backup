<Window x:Class="ErongoIT.Backup.Agent.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ErongoIT Backup"
        Width="1180"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6"
        Icon="pack://application:,,,/app.ico">

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D5D9DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="NavigationButton"
               TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="CardText"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="#20242A"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Border Grid.Row="0"
                Background="#20242A"
                Padding="24,0">

            <Grid>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="ErongoIT Backup"
                               Foreground="White"
                               FontSize="21"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Backup Agent"
                               Foreground="#AEB4BC"
                               FontSize="12"/>

                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Ellipse x:Name="ConnectionIndicator"
                             Width="10"
                             Height="10"
                             Fill="#777777"
                             Margin="0,0,8,0"/>

                    <TextBlock x:Name="ConnectionText"
                               Text="Disconnected"
                               Foreground="White"
                               FontSize="13"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- BODY -->

        <Grid Grid.Row="1"
              Margin="24">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- NAVIGATION -->

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="6"
                    Margin="0,0,18,0">

                <StackPanel Margin="10">

                    <Button x:Name="OverviewButton"
                            Content="Overview"
                            Style="{StaticResource NavigationButton}"
                            Click="Overview_Click"/>

                    <Button x:Name="BackupButton"
                            Content="Backup"
                            Style="{StaticResource NavigationButton}"
                            Click="Backup_Click"/>

                    <Button Content="Restore"
                            Style="{StaticResource NavigationButton}"
                            Click="Restore_Click"/>

                    <Button Content="History"
                            Style="{StaticResource NavigationButton}"
                            Click="History_Click"/>

                    <Separator Margin="8,12"/>

                    <Button Content="Settings"
                            Style="{StaticResource NavigationButton}"
                            Click="Settings_Click"/>

                </StackPanel>

            </Border>

            <!-- CONTENT -->

            <Grid Grid.Column="1">

                <!-- OVERVIEW -->

                <ScrollViewer x:Name="OverviewView"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="Backup Overview"
                                   FontSize="26"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="OverviewSubtitle"
                                   Text="Loading backup information..."
                                   Foreground="#68717C"
                                   Margin="0,5,0,22"/>

                        <Border Background="White"
                                CornerRadius="6"
                                Padding="22"
                                Margin="0,0,0,18">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="58"
                                        Height="58"
                                        CornerRadius="29"
                                        Background="#E8F5E9">

                                    <TextBlock x:Name="StatusIcon"
                                               Text="✓"
                                               FontSize="30"
                                               Foreground="#2E7D32"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="18,0,0,0">

                                    <TextBlock x:Name="ProtectionStatus"
                                               Text="Checking protection status..."
                                               FontSize="19"
                                               FontWeight="SemiBold"/>

                                    <TextBlock x:Name="ProtectionDetails"
                                               Text=""
                                               Foreground="#68717C"
                                               Margin="0,4,0,0"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                        <Border Background="White"
                                CornerRadius="6"
                                Padding="22"
                                Margin="0,0,0,18">

                            <StackPanel>

                                <Grid>

                                    <TextBlock Text="Backup status"
                                               FontSize="17"
                                               FontWeight="SemiBold"/>

                                    <TextBlock x:Name="CurrentJobStatus"
                                               Text="Idle"
                                               HorizontalAlignment="Right"
                                               Foreground="#68717C"/>

                                </Grid>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,12,0,0">

                                    <Button x:Name="BackUpNowButton"
                                            Content="Back Up Now"
                                            Click="BackUpNow_Click"
                                            Margin="0,0,8,0"/>

                                    <Button x:Name="StopBackupButton"
                                            Content="Stop Backup"
                                            Click="StopBackup_Click"
                                            Visibility="Collapsed"/>

                                </StackPanel>

                                <ProgressBar x:Name="BackupProgress"
                                             Height="8"
                                             Margin="0,16,0,12"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="0"/>

                                <Grid>

                                    <TextBlock x:Name="BackupProgressText"
                                               Text="No active backup"
                                               Foreground="#68717C"
                                               FontSize="13"/>

                                    <TextBlock x:Name="BackupProgressPercent"
                                               Text="0%"
                                               HorizontalAlignment="Right"
                                               Foreground="#68717C"
                                               FontSize="13"/>

                                </Grid>

                            </StackPanel>

                        </Border>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="White"
                                    CornerRadius="6"
                                    Padding="22"
                                    Margin="0,0,9,18">

                                <StackPanel>

                                    <TextBlock Text="Device"
                                               Foreground="#68717C"/>

                                    <TextBlock x:Name="DeviceName"
                                               Text="—"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               Margin="0,6,0,0"/>

                                    <TextBlock x:Name="DeviceDetails"
                                               Text="—"
                                               Foreground="#68717C"
                                               Margin="0,4,0,0"/>

                                </StackPanel>

                            </Border>

                            <Border Grid.Column="1"
                                    Background="White"
                                    CornerRadius="6"
                                    Padding="22"
                                    Margin="9,0,0,18">

                                <StackPanel>

                                    <TextBlock Text="Backup plan"
                                               Foreground="#68717C"/>

                                    <TextBlock x:Name="PlanName"
                                               Text="—"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               Margin="0,6,0,0"/>

                                    <TextBlock x:Name="PlanDetails"
                                               Text="—"
                                               Foreground="#68717C"
                                               Margin="0,4,0,0"/>

                                </StackPanel>

                            </Border>

                        </Grid>

                        <Border Background="White"
                                CornerRadius="6"
                                Padding="22">

                            <StackPanel>

                                <TextBlock Text="Latest backup"
                                           FontSize="17"
                                           FontWeight="SemiBold"/>

                                <TextBlock x:Name="LatestBackupText"
                                           Text="No completed backups found."
                                           Foreground="#68717C"
                                           Margin="0,12,0,0"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

                <!-- BACKUP -->

                <ScrollViewer x:Name="BackupView"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">

                    <StackPanel>

                        <TextBlock Text="Backup"
                                   FontSize="26"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Choose what this computer protects."
                                   Foreground="#68717C"
                                   Margin="0,5,0,22"/>

                        <Border Background="White"
                                CornerRadius="6"
                                Padding="22"
                                Margin="0,0,0,18">

                            <StackPanel>

                                <Grid>

                                    <TextBlock Text="Files and folders"
                                               FontSize="17"
                                               FontWeight="SemiBold"/>

                                    <Button Content="Add folder"
                                            HorizontalAlignment="Right"
                                            Click="AddFolder_Click"/>

                                </Grid>

                                <TextBlock Text="These folders will be included in the backup. Changes are saved straight away (Windows asks for administrator approval)."
                                           Foreground="#68717C"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,16"/>

                                <ListBox x:Name="FolderList"
                                         MinHeight="180"
                                         BorderBrush="#D5D9DE"
                                         HorizontalContentAlignment="Stretch">

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,4">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding}"
                                                           Margin="4,0,12,0"/>

                                                <Button Grid.Column="1"
                                                        Content="Remove"
                                                        Tag="{Binding}"
                                                        Padding="12,4"
                                                        FontSize="13"
                                                        Foreground="#B42318"
                                                        ToolTip="Stop backing up this folder"
                                                        Click="RemoveFolder_Click"/>

                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>

                                </ListBox>

                            </StackPanel>

                        </Border>

                        <Border Background="White"
                                CornerRadius="6"
                                Padding="22"
                                Margin="0,0,0,18">

                            <StackPanel>

                                <TextBlock Text="Backup plan"
                                           FontSize="17"
                                           FontWeight="SemiBold"/>

                                <Grid Margin="0,14,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Assigned plan"
                                               Foreground="#68717C"/>

                                    <TextBlock x:Name="BackupPagePlan"
                                               Grid.Column="1"
                                               Text="Loading..."
                                               FontWeight="SemiBold"/>

                                </Grid>

                                <Grid Margin="0,10,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Schedule"
                                               Foreground="#68717C"/>

                                    <TextBlock x:Name="BackupPageSchedule"
                                               Grid.Column="1"
                                               Text="Loading..."/>

                                </Grid>

                                <Grid Margin="0,10,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Retention"
                                               Foreground="#68717C"/>

                                    <TextBlock x:Name="BackupPageRetention"
                                               Grid.Column="1"
                                               Text="Loading..."/>

                                </Grid>

                            </StackPanel>

                        </Border>

                        <Border Background="White"
                                CornerRadius="6"
                                Padding="22">

                            <StackPanel>

                                <TextBlock Text="Source"
                                           FontSize="17"
                                           FontWeight="SemiBold"/>

                                <TextBlock x:Name="SourcePathText"
                                           Text="—"
                                           Margin="0,10,0,0"
                                           FontFamily="Consolas"/>

                                <TextBlock x:Name="FolderCountText"
                                           Text="0 folders selected"
                                           Foreground="#68717C"
                                           Margin="0,5,0,0"/>

                                <Button x:Name="BackupPageBackUpNowButton"
                                        Content="Back Up Now"
                                        HorizontalAlignment="Right"
                                        Margin="0,18,0,0"
                                        Click="BackUpNow_Click"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

                    <!-- RESTORE (CrashPlan-style browser) -->

                    <Grid x:Name="RestoreView"
                          Visibility="Collapsed">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title -->
                        <StackPanel Grid.Row="0">

                            <TextBlock Text="Restore"
                                       FontSize="26"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Open folders, tick the files and folders you want back, and choose a date to restore them as they were then."
                                       Foreground="#68717C"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,14"/>

                        </StackPanel>

                        <!-- Toolbar: breadcrumb on its own line, then search / as-of / options -->
                        <Border Grid.Row="1"
                                Background="White"
                                BorderBrush="#D8DCE1"
                                BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0"
                                Padding="14,10">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Breadcrumb: This PC › C: › Users › ... (one line, scrolls if long) -->
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">

                                    <ItemsControl x:Name="RestoreBreadcrumb">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center">

                                                    <!-- Separator before every item except the first -->
                                                    <TextBlock Text="›"
                                                               Foreground="#9AA1A9"
                                                               FontSize="15"
                                                               VerticalAlignment="Center"
                                                               Margin="6,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}"
                                                                                 Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <Button Content="{Binding Name}"
                                                            Tag="{Binding Path}"
                                                            Click="RestoreBreadcrumb_Click"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="2,2"
                                                            FontSize="14"
                                                            Foreground="#1F5FAD"
                                                            Cursor="Hand"/>

                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                </ScrollViewer>

                                <Grid Grid.Row="1"
                                      Margin="0,10,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Search -->
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">

                                        <TextBox x:Name="RestoreSearchText"
                                                 Width="220"
                                                 Height="30"
                                                 Padding="6,0"
                                                 VerticalAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="Search all backed-up files by name"
                                                 KeyDown="RestoreSearchText_KeyDown"/>

                                        <Button Content="Search"
                                                Height="30"
                                                Padding="12,0"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Click="RestoreSearch_Click"/>

                                    </StackPanel>

                                    <!-- As of date / time -->
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="As of"
                                                   VerticalAlignment="Center"
                                                   Foreground="#68717C"
                                                   Margin="0,0,8,0"/>

                                        <DatePicker x:Name="RestoreAsOfDate"
                                                    Width="130"
                                                    Height="30"
                                                    VerticalAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    SelectedDateChanged="RestoreAsOf_Changed"/>

                                        <ComboBox x:Name="RestoreAsOfHour"
                                                  Width="58"
                                                  Height="30"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  VerticalContentAlignment="Center"
                                                  SelectionChanged="RestoreAsOf_Changed"/>

                                        <TextBlock Text=":"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0"/>

                                        <ComboBox x:Name="RestoreAsOfMinute"
                                                  Width="58"
                                                  Height="30"
                                                  VerticalAlignment="Center"
                                                  VerticalContentAlignment="Center"
                                                  SelectionChanged="RestoreAsOf_Changed"/>

                                        <Button Content="Most current"
                                                Height="30"
                                                Padding="12,0"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                ToolTip="Show the latest backed-up version of every file"
                                                Click="RestoreMostCurrent_Click"/>

                                    </StackPanel>

                                    <!-- Options -->
                                    <CheckBox x:Name="RestoreIncludeDeleted"
                                              Grid.Column="2"
                                              Content="Include deleted files"
                                              VerticalAlignment="Center"
                                              Checked="RestoreIncludeDeleted_Changed"
                                              Unchecked="RestoreIncludeDeleted_Changed"/>

                                </Grid>

                            </Grid>

                        </Border>

                        <!-- Folder / file list -->
                        <DataGrid x:Name="RestoreFilesGrid"
                                  Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#ECEEF1"
                                  Background="White"
                                  BorderBrush="#D8DCE1"
                                  RowHeight="34"
                                  MouseDoubleClick="RestoreFilesGrid_MouseDoubleClick">

                            <DataGrid.Columns>

                                <DataGridTemplateColumn Width="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=OneWay}"
                                                      IsEnabled="{Binding CanToggle}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Click="RestoreRowCheck_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Name"
                                                        Width="*"
                                                        SortMemberPath="SortName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        ToolTip="{Binding Path}">

                                                <TextBlock Text="{Binding Icon}"
                                                           FontFamily="Segoe UI Emoji"
                                                           Margin="2,0,8,0"/>

                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{Binding NameBrush}"
                                                           FontStyle="{Binding NameStyle}"/>

                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Size"
                                                    Binding="{Binding SizeDisplay}"
                                                    SortMemberPath="SizeBytes"
                                                    IsReadOnly="True"
                                                    Width="110"/>

                                <DataGridTextColumn Header="Date Modified"
                                                    Binding="{Binding ModifiedDisplay}"
                                                    SortMemberPath="ModifiedSort"
                                                    IsReadOnly="True"
                                                    Width="170"/>

                            </DataGrid.Columns>

                        </DataGrid>

                        <!-- Restore file pages -->
                        <StackPanel Grid.Row="3"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">

                                <Button x:Name="RestoreFirstPageButton"
                                        Content="|&lt;"
                                        Padding="10,4"
                                        ToolTip="First page"
                                        Click="RestorePage_Click"
                                        Tag="first"/>

                                <Button x:Name="RestorePreviousPageButton"
                                        Content="&lt; Previous"
                                        Padding="10,4"
                                        Margin="6,0,0,0"
                                        Click="RestorePage_Click"
                                        Tag="previous"/>

                                <TextBlock x:Name="RestorePageNumberText"
                                           Text="Page 1 of 1"
                                           VerticalAlignment="Center"
                                           MinWidth="110"
                                           TextAlignment="Center"
                                           Margin="10,0"/>

                                <Button x:Name="RestoreNextPageButton"
                                        Content="Next &gt;"
                                        Padding="10,4"
                                        Click="RestorePage_Click"
                                        Tag="next"/>

                                <Button x:Name="RestoreLastPageButton"
                                        Content="&gt;|"
                                        Padding="10,4"
                                        Margin="6,0,0,0"
                                        ToolTip="Last page"
                                        Click="RestorePage_Click"
                                        Tag="last"/>

                            </StackPanel>

                            <TextBlock x:Name="RestorePageInfo"
                                       Text="No files"
                                       Foreground="#68717C"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"/>

                        </StackPanel>

                        <!-- Selection summary, progress and buttons -->
                        <Grid Grid.Row="4"
                              Margin="0,10,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock x:Name="RestoreSelectionText"
                                           Text="Nothing selected"
                                           FontWeight="SemiBold"/>

                                <TextBlock x:Name="RestoreStatusText"
                                           Text=""
                                           Foreground="#68717C"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>

                                <ProgressBar x:Name="RestoreProgress"
                                             Height="6"
                                             Margin="0,6,20,0"
                                             Visibility="Collapsed"/>

                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <Button x:Name="RestoreClearButton"
                                        Content="Clear selection"
                                        Padding="12,6"
                                        Click="RestoreClearSelection_Click"/>

                                <Button x:Name="RestoreCancelButton"
                                        Content="Stop"
                                        Padding="12,6"
                                        Margin="8,0,0,0"
                                        Visibility="Collapsed"
                                        Click="RestoreCancel_Click"/>

                                <Button x:Name="RestoreBackupButton"
                                        Content="Restore Files..."
                                        IsEnabled="False"
                                        Padding="16,6"
                                        Margin="8,0,0,0"
                                        Background="#1F6FD1"
                                        Foreground="White"
                                        Click="RestoreFiles_Click"/>

                            </StackPanel>

                        </Grid>

                    </Grid>

<!-- HISTORY -->

                <Grid x:Name="HistoryView"
                      Visibility="Collapsed">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">

                        <TextBlock Text="Backup History"
                                   FontSize="26"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Completed and failed backup jobs."
                                   Foreground="#68717C"
                                   Margin="0,5,0,22"/>

                    </StackPanel>

                        <DataGrid x:Name="HistoryGrid"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="White"
                                  BorderThickness="0"
                                  HeadersVisibility="Column">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Status"
                                                    Binding="{Binding Status}"
                                                    Width="110"/>

                                <DataGridTextColumn Header="Started"
                                                    Binding="{Binding StartedDisplay}"
                                                    Width="180"/>

                                <DataGridTextColumn Header="Completed"
                                                    Binding="{Binding CompletedDisplay}"
                                                    Width="180"/>

                                <DataGridTextColumn Header="Files"
                                                    Binding="{Binding FilesDisplay}"
                                                    Width="100"/>

                                <DataGridTextColumn Header="Uploaded"
                                                    Binding="{Binding UploadedDisplay}"
                                                    Width="140"/>

                                <DataGridTextColumn Header="Job"
                                                    Binding="{Binding Id}"
                                                    Width="*"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    <!-- History pages -->
                    <Border Grid.Row="2">
                    <StackPanel Margin="0,10,0,0"
                                                HorizontalAlignment="Center">

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">

                                            <Button x:Name="HistoryFirstPageButton"
                                                    Content="|&lt;"
                                                    Padding="10,4"
                                                    ToolTip="First page"
                                                    Click="HistoryPage_Click"
                                                    Tag="first"/>

                                            <Button x:Name="HistoryPreviousPageButton"
                                                    Content="&lt; Previous"
                                                    Padding="10,4"
                                                    Margin="6,0,0,0"
                                                    Click="HistoryPage_Click"
                                                    Tag="previous"/>

                                            <TextBlock x:Name="HistoryPageNumberText"
                                                       Text="Page 1 of 1"
                                                       VerticalAlignment="Center"
                                                       MinWidth="110"
                                                       TextAlignment="Center"
                                                       Margin="10,0"/>

                                            <Button x:Name="HistoryNextPageButton"
                                                    Content="Next &gt;"
                                                    Padding="10,4"
                                                    Click="HistoryPage_Click"
                                                    Tag="next"/>

                                            <Button x:Name="HistoryLastPageButton"
                                                    Content="&gt;|"
                                                    Padding="10,4"
                                                    Margin="6,0,0,0"
                                                    ToolTip="Last page"
                                                    Click="HistoryPage_Click"
                                                    Tag="last"/>

                                        </StackPanel>

                                        <TextBlock x:Name="HistoryPageInfo"
                                                   Text="No backups"
                                                   Foreground="#68717C"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,6,0,0"/>

                                    </StackPanel>
                    </Border>

                </Grid>

                <!-- SETTINGS -->

                <ScrollViewer x:Name="SettingsView"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">

                    <StackPanel>

                        <TextBlock Text="Settings"
                                   FontSize="26"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Connection and local agent configuration."
                                   Foreground="#68717C"
                                   Margin="0,5,0,22"/>

                        <Border Background="White"
                                CornerRadius="6"
                                Padding="22">

                            <StackPanel>

                                <TextBlock Text="Connection"
                                           FontSize="17"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Backup API"
                                           Foreground="#68717C"
                                           Margin="0,18,0,4"/>

                                <TextBlock x:Name="SettingsApiUrl"
                                           FontFamily="Consolas"/>

                                <TextBlock Text="Customer ID"
                                           Foreground="#68717C"
                                           Margin="0,18,0,4"/>

                                <TextBlock x:Name="SettingsCustomerId"
                                           FontFamily="Consolas"/>

                                <TextBlock Text="Device ID"
                                           Foreground="#68717C"
                                           Margin="0,18,0,4"/>

                                <TextBlock x:Name="SettingsDeviceId"
                                           FontFamily="Consolas"/>

                                <TextBlock Text="Mode"
                                           Foreground="#68717C"
                                           Margin="0,18,0,4"/>

                                <TextBlock x:Name="SettingsModeText"
                                           TextWrapping="Wrap"/>

                                <Button Content="Change setup..."
                                        HorizontalAlignment="Left"
                                        Padding="14,6"
                                        Margin="0,22,0,0"
                                        Click="ChangeSetup_Click"
                                        ToolTip="Register this PC again, change customer, plan or folders (needs administrator rights)."/>

                            </StackPanel>

                        </Border>

                        <Border Background="White"
                                CornerRadius="6"
                                Padding="22"
                                Margin="0,18,0,0">

                            <StackPanel>

                                <TextBlock Text="Display"
                                           FontSize="17"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Lines per page (Restore and History lists)"
                                           Foreground="#68717C"
                                           Margin="0,18,0,6"/>

                                <ComboBox x:Name="RowsPerPageComboBox"
                                          Width="140"
                                          Height="32"
                                          HorizontalAlignment="Left"
                                          VerticalContentAlignment="Center"
                                          SelectionChanged="RowsPerPageComboBox_SelectionChanged"/>

                                <TextBlock Text="Saved for your Windows user on this PC."
                                           Foreground="#68717C"
                                           FontSize="12"
                                           Margin="0,6,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border Background="White"
                                CornerRadius="6"
                                Padding="22"
                                Margin="0,18,0,0">

                            <StackPanel>

                                <TextBlock Text="What's new"
                                           FontSize="17"
                                           FontWeight="SemiBold"/>

                                <TextBox x:Name="WhatsNewText"
                                         Margin="0,14,0,0"
                                         MaxHeight="320"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         FontSize="13"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </Grid>

        </Grid>

        <!-- FOOTER -->

        <Border Grid.Row="2"
                Background="#E7E9EC"
                Padding="24,0">

            <Grid>

                <TextBlock Text="ErongoIT Backup Agent"
                           Foreground="#68717C"
                           FontSize="12"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="FooterVersion"
                           Text="Agent 1.0.0"
                           Foreground="#68717C"
                           FontSize="12"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>

    </Grid>

</Window>
