<Window x:Class="ErongoIT.Backup.Agent.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ErongoIT Backup"
        Width="1180"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D5D9DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="NavigationButton"
               TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="CardText"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="#20242A"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Border Grid.Row="0"
                Background="#20242A"
                Padding="24,0">

            <Grid>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="ErongoIT Backup"
                               Foreground="White"
                               FontSize="21"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Backup Agent"
                               Foreground="#AEB4BC"
                               FontSize="12"/>

                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Ellipse x:Name="ConnectionIndicator"
                             Width="10"
                             Height="10"
                             Fill="#777777"
                             Margin="0,0,8,0"/>

                    <TextBlock x:Name="ConnectionText"
                               Text="Disconnected"
                               Foreground="White"
                               FontSize="13"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- BODY -->

        <Grid Grid.Row="1"
              Margin="24">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- NAVIGATION -->

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="6"
                    Margin="0,0,18,0">

                <StackPanel Margin="10">

                    <Button x:Name="OverviewButton"
                            Content="Overview"
                            Style="{StaticResource NavigationButton}"
                            Click="Overview_Click"/>

                    <Button x:Name="BackupButton"
                            Content="Backup"
                            Style="{StaticResource NavigationButton}"
                            Click="Backup_Click"/>

                    <Button Content="Restore"
                            Style="{StaticResource NavigationButton}"
                            Click="Restore_Click"/>

                    <Button Content="History"
                            Style="{StaticResource NavigationButton}"
                            Click="History_Click"/>

                    <Separator Margin="8,12"/>

                    <Button Content="Settings"
                            Style="{StaticResource NavigationButton}"
                            Click="Settings_Click"/>

                </StackPanel>

            </Border>

            <!-- CONTENT -->

            <Grid Grid.Column="1">

                <!-- OVERVIEW -->

                <ScrollViewer x:Name="OverviewView"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="Backup Overview"
                                   FontSize="26"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="OverviewSubtitle"
                                   Text="Loading backup information..."
                                   Foreground="#68717C"
                                   Margin="0,5,0,22"/>

                        <Border Background="White"
                                CornerRadius="6"
                                Padding="22"
                                Margin="0,0,0,18">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="58"
                                        Height="58"
                                        CornerRadius="29"
                                        Background="#E8F5E9">

                                    <TextBlock x:Name="StatusIcon"
                                               Text="✓"
                                               FontSize="30"
                                               Foreground="#2E7D32"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="18,0,0,0">

                                    <TextBlock x:Name="ProtectionStatus"
                                               Text="Checking protection status..."
                                               FontSize="19"
                                               FontWeight="SemiBold"/>

                                    <TextBlock x:Name="ProtectionDetails"
                                               Text=""
                                               Foreground="#68717C"
                                               Margin="0,4,0,0"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                        <Border Background="White"
                                CornerRadius="6"
                                Padding="22"
                                Margin="0,0,0,18">

                            <StackPanel>

                                <Grid>

                                    <TextBlock Text="Backup status"
                                               FontSize="17"
                                               FontWeight="SemiBold"/>

                                    <TextBlock x:Name="CurrentJobStatus"
                                               Text="Idle"
                                               HorizontalAlignment="Right"
                                               Foreground="#68717C"/>

                                </Grid>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,12,0,0">

                                    <Button x:Name="BackUpNowButton"
                                            Content="Back Up Now"
                                            Click="BackUpNow_Click"
                                            Margin="0,0,8,0"/>

                                    <Button x:Name="StopBackupButton"
                                            Content="Stop Backup"
                                            Click="StopBackup_Click"
                                            Visibility="Collapsed"/>

                                </StackPanel>

                                <ProgressBar x:Name="BackupProgress"
                                             Height="8"
                                             Margin="0,16,0,12"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="0"/>

                                <Grid>

                                    <TextBlock x:Name="BackupProgressText"
                                               Text="No active backup"
                                               Foreground="#68717C"
                                               FontSize="13"/>

                                    <TextBlock x:Name="BackupProgressPercent"
                                               Text="0%"
                                               HorizontalAlignment="Right"
                                               Foreground="#68717C"
                                               FontSize="13"/>

                                </Grid>

                            </StackPanel>

                        </Border>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="White"
                                    CornerRadius="6"
                                    Padding="22"
                                    Margin="0,0,9,18">

                                <StackPanel>

                                    <TextBlock Text="Device"
                                               Foreground="#68717C"/>

                                    <TextBlock x:Name="DeviceName"
                                               Text="—"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               Margin="0,6,0,0"/>

                                    <TextBlock x:Name="DeviceDetails"
                                               Text="—"
                                               Foreground="#68717C"
                                               Margin="0,4,0,0"/>

                                </StackPanel>

                            </Border>

                            <Border Grid.Column="1"
                                    Background="White"
                                    CornerRadius="6"
                                    Padding="22"
                                    Margin="9,0,0,18">

                                <StackPanel>

                                    <TextBlock Text="Backup plan"
                                               Foreground="#68717C"/>

                                    <TextBlock x:Name="PlanName"
                                               Text="—"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               Margin="0,6,0,0"/>

                                    <TextBlock x:Name="PlanDetails"
                                               Text="—"
                                               Foreground="#68717C"
                                               Margin="0,4,0,0"/>

                                </StackPanel>

                            </Border>

                        </Grid>

                        <Border Background="White"
                                CornerRadius="6"
                                Padding="22">

                            <StackPanel>

                                <TextBlock Text="Latest backup"
                                           FontSize="17"
                                           FontWeight="SemiBold"/>

                                <TextBlock x:Name="LatestBackupText"
                                           Text="No completed backups found."
                                           Foreground="#68717C"
                                           Margin="0,12,0,0"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

                <!-- BACKUP -->

                <ScrollViewer x:Name="BackupView"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">

                    <StackPanel>

                        <TextBlock Text="Backup"
                                   FontSize="26"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Choose what this computer protects."
                                   Foreground="#68717C"
                                   Margin="0,5,0,22"/>

                        <Border Background="White"
                                CornerRadius="6"
                                Padding="22"
                                Margin="0,0,0,18">

                            <StackPanel>

                                <Grid>

                                    <TextBlock Text="Files and folders"
                                               FontSize="17"
                                               FontWeight="SemiBold"/>

                                    <Button Content="Add folder"
                                            HorizontalAlignment="Right"
                                            Click="AddFolder_Click"/>

                                </Grid>

                                <TextBlock Text="These folders will be included in the backup."
                                           Foreground="#68717C"
                                           Margin="0,5,0,16"/>

                                <ListBox x:Name="FolderList"
                                         MinHeight="180"
                                         BorderBrush="#D5D9DE"/>

                            </StackPanel>

                        </Border>

                        <Border Background="White"
                                CornerRadius="6"
                                Padding="22"
                                Margin="0,0,0,18">

                            <StackPanel>

                                <TextBlock Text="Backup plan"
                                           FontSize="17"
                                           FontWeight="SemiBold"/>

                                <Grid Margin="0,14,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Assigned plan"
                                               Foreground="#68717C"/>

                                    <TextBlock x:Name="BackupPagePlan"
                                               Grid.Column="1"
                                               Text="Loading..."
                                               FontWeight="SemiBold"/>

                                </Grid>

                                <Grid Margin="0,10,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Schedule"
                                               Foreground="#68717C"/>

                                    <TextBlock x:Name="BackupPageSchedule"
                                               Grid.Column="1"
                                               Text="Loading..."/>

                                </Grid>

                                <Grid Margin="0,10,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Retention"
                                               Foreground="#68717C"/>

                                    <TextBlock x:Name="BackupPageRetention"
                                               Grid.Column="1"
                                               Text="Loading..."/>

                                </Grid>

                            </StackPanel>

                        </Border>

                        <Border Background="White"
                                CornerRadius="6"
                                Padding="22">

                            <StackPanel>

                                <TextBlock Text="Source"
                                           FontSize="17"
                                           FontWeight="SemiBold"/>

                                <TextBlock x:Name="SourcePathText"
                                           Text="—"
                                           Margin="0,10,0,0"
                                           FontFamily="Consolas"/>

                                <TextBlock x:Name="FolderCountText"
                                           Text="0 folders selected"
                                           Foreground="#68717C"
                                           Margin="0,5,0,0"/>

                                <Button x:Name="BackupPageBackUpNowButton"
                                        Content="Back Up Now"
                                        HorizontalAlignment="Right"
                                        Margin="0,18,0,0"
                                        Click="BackUpNow_Click"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

                    <!-- RESTORE -->

                    <Grid x:Name="RestoreView"
                          Visibility="Collapsed">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">

                            <TextBlock Text="Restore"
                                       FontSize="26"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Choose a backup date, select what you want to restore, and choose where to put it."
                                       Foreground="#68717C"
                                       Margin="0,5,0,18"/>

                        </StackPanel>

                        <Grid Grid.Row="1">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="White"
                                    BorderBrush="#D8DCE1"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="15">

                                <StackPanel>

                                    <TextBlock Text="Backup dates"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10"/>

                                    <Calendar x:Name="RestoreCalendar"
                                              SelectedDatesChanged="RestoreCalendar_SelectedDatesChanged"
                                              DisplayDateChanged="RestoreCalendar_DisplayDateChanged"/>

                                    <TextBlock x:Name="RestoreCalendarDetails"
                                               Text="Select a date with a completed backup."
                                               Foreground="#68717C"
                                               TextWrapping="Wrap"
                                               Margin="0,12,0,0"/>

                                </StackPanel>

                            </Border>

                            <Border Grid.Column="2"
                                    Background="White"
                                    BorderBrush="#D8DCE1"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="20">

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Backups on this date"
                                               FontSize="15"
                                               FontWeight="SemiBold"/>

                                    <ComboBox x:Name="RestoreJobComboBox"
                                              Grid.Row="1"
                                              Height="34"
                                              Margin="0,8,0,15"
                                              SelectionChanged="RestoreJobComboBox_SelectionChanged"/>

                                    <DataGrid x:Name="RestoreFilesGrid"
                                              Grid.Row="2"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              Background="White"
                                              CanUserAddRows="False">

                                        <DataGrid.Columns>

                                            <DataGridTextColumn Header="File"
                                                                Binding="{Binding RelativePath}"
                                                                Width="*"/>

                                            <DataGridTextColumn Header="Size"
                                                                Binding="{Binding SizeDisplay}"
                                                                Width="110"/>

                                        </DataGrid.Columns>

                                    </DataGrid>

                                    <StackPanel Grid.Row="3"
                                                Margin="0,15,0,0">

                                        <TextBlock Text="Restore destination"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,8"/>

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox x:Name="RestoreDestinationText"
                                                     Height="34"
                                                     VerticalContentAlignment="Center"/>

                                            <Button Grid.Column="1"
                                                    Content="Browse..."
                                                    Height="34"
                                                    Margin="8,0,0,0"
                                                    Padding="12,0"
                                                    Click="BrowseRestoreDestination_Click"/>

                                        </Grid>

                                        <Grid Margin="0,15,0,0">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock x:Name="RestoreStatusText"
                                                       Text="Select a backup date."
                                                       Foreground="#68717C"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"/>

                                            <Button x:Name="RestoreBackupButton"
                                                    Grid.Column="1"
                                                    Content="Restore Selected Backup"
                                                    IsEnabled="False"
                                                    Padding="14,7"
                                                    Click="RestoreBackup_Click"/>

                                        </Grid>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </Grid>

                    </Grid>

<!-- HISTORY -->

                <Grid x:Name="HistoryView"
                      Visibility="Collapsed">

                    <StackPanel>

                        <TextBlock Text="Backup History"
                                   FontSize="26"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Completed and failed backup jobs."
                                   Foreground="#68717C"
                                   Margin="0,5,0,22"/>

                        <DataGrid x:Name="HistoryGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="White"
                                  BorderThickness="0"
                                  HeadersVisibility="Column">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Status"
                                                    Binding="{Binding Status}"
                                                    Width="110"/>

                                <DataGridTextColumn Header="Started"
                                                    Binding="{Binding StartedDisplay}"
                                                    Width="180"/>

                                <DataGridTextColumn Header="Completed"
                                                    Binding="{Binding CompletedDisplay}"
                                                    Width="180"/>

                                <DataGridTextColumn Header="Files"
                                                    Binding="{Binding FilesDisplay}"
                                                    Width="100"/>

                                <DataGridTextColumn Header="Uploaded"
                                                    Binding="{Binding UploadedDisplay}"
                                                    Width="140"/>

                                <DataGridTextColumn Header="Job"
                                                    Binding="{Binding Id}"
                                                    Width="*"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </StackPanel>

                </Grid>

                <!-- SETTINGS -->

                <ScrollViewer x:Name="SettingsView"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">

                    <StackPanel>

                        <TextBlock Text="Settings"
                                   FontSize="26"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Connection and local agent configuration."
                                   Foreground="#68717C"
                                   Margin="0,5,0,22"/>

                        <Border Background="White"
                                CornerRadius="6"
                                Padding="22">

                            <StackPanel>

                                <TextBlock Text="Connection"
                                           FontSize="17"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Backup API"
                                           Foreground="#68717C"
                                           Margin="0,18,0,4"/>

                                <TextBlock x:Name="SettingsApiUrl"
                                           FontFamily="Consolas"/>

                                <TextBlock Text="Customer ID"
                                           Foreground="#68717C"
                                           Margin="0,18,0,4"/>

                                <TextBlock x:Name="SettingsCustomerId"
                                           FontFamily="Consolas"/>

                                <TextBlock Text="Device ID"
                                           Foreground="#68717C"
                                           Margin="0,18,0,4"/>

                                <TextBlock x:Name="SettingsDeviceId"
                                           FontFamily="Consolas"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </Grid>

        </Grid>

        <!-- FOOTER -->

        <Border Grid.Row="2"
                Background="#E7E9EC"
                Padding="24,0">

            <Grid>

                <TextBlock Text="ErongoIT Backup Agent"
                           Foreground="#68717C"
                           FontSize="12"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="FooterVersion"
                           Text="Agent 1.0.0"
                           Foreground="#68717C"
                           FontSize="12"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>

    </Grid>

</Window>
