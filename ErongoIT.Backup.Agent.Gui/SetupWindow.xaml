<Window x:Class="ErongoIT.Backup.Agent.Gui.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ErongoIT Backup - Setup"
        Width="640"
        Height="760"
        MinWidth="560"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8"
        Icon="pack://application:,,,/app.ico">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8DCE1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#68717C"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="Step" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,5"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="6,5"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,5"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="#1F232A"
                Padding="24,16">
            <StackPanel>
                <TextBlock Text="ErongoIT Backup"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Register this computer with the backup server"
                           Foreground="#B8BEC6"/>
            </StackPanel>
        </Border>

        <!-- Footer buttons -->
        <Border DockPanel.Dock="Bottom"
                Background="#E7E9EC"
                Padding="24,12">
            <Grid>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,220,0"
                           Foreground="#68717C"
                           Text="Sign in to continue."/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Margin="0,0,8,0"
                            Click="Cancel_Click"/>
                    <Button x:Name="RegisterButton"
                            Content="Register this PC"
                            IsEnabled="False"
                            Click="Register_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18,24,6">

                <!-- STEP 1 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="1. Sign in"
                                   Style="{StaticResource Step}"/>
                        <TextBlock Text="Your ErongoIT admin login is used only to register this PC. It is not stored on this computer."
                                   TextWrapping="Wrap"
                                   Foreground="#68717C"
                                   Margin="0,4,0,0"/>

                        <TextBlock Text="Backup server"
                                   Style="{StaticResource Label}"/>
                        <TextBox x:Name="ServerBox"
                                 Text="https://backup.erongoit.com"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Username"
                                           Style="{StaticResource Label}"/>
                                <TextBox x:Name="UsernameBox"
                                         Text="admin"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Password"
                                           Style="{StaticResource Label}"/>
                                <PasswordBox x:Name="PasswordBox"
                                             KeyDown="PasswordBox_KeyDown"/>
                            </StackPanel>
                        </Grid>

                        <Button x:Name="SignInButton"
                                Content="Sign in"
                                HorizontalAlignment="Left"
                                Margin="0,14,0,0"
                                Click="SignIn_Click"/>
                    </StackPanel>
                </Border>

                <!-- STEP 2 -->
                <Border x:Name="CustomerCard"
                        Style="{StaticResource Card}"
                        IsEnabled="False"
                        Opacity="0.5">
                    <StackPanel>
                        <TextBlock Text="2. Customer and backup plan"
                                   Style="{StaticResource Step}"/>

                        <TextBlock Text="Customer"
                                   Style="{StaticResource Label}"/>
                        <ComboBox x:Name="CustomerCombo"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="CustomerCombo_SelectionChanged"/>

                        <TextBlock Text="Backup plan"
                                   Style="{StaticResource Label}"/>
                        <ComboBox x:Name="PlanCombo"
                                  DisplayMemberPath="Name"/>

                        <TextBlock Text="Computer name (as shown in the portal)"
                                   Style="{StaticResource Label}"/>
                        <TextBox x:Name="DeviceNameBox"/>
                    </StackPanel>
                </Border>

                <!-- STEP 3 -->
                <Border x:Name="FoldersCard"
                        Style="{StaticResource Card}"
                        IsEnabled="False"
                        Opacity="0.5">
                    <StackPanel>
                        <TextBlock Text="3. Folders to back up"
                                   Style="{StaticResource Step}"/>

                        <ListBox x:Name="FolderList"
                                 Height="150"
                                 Margin="0,10,0,0"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,8,0,0">
                            <Button Content="Add folder..."
                                    Margin="0,0,8,0"
                                    Click="AddFolder_Click"/>
                            <Button Content="Remove"
                                    Click="RemoveFolder_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
