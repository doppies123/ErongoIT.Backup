<Window x:Class="ErongoIT.Backup.ServiceManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ErongoIT Backup - Service Manager"
        Width="760"
        Height="650"
        MinWidth="700"
        MinHeight="450"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="ErongoIT Backup"
                       FontSize="26"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Service Manager"
                       FontSize="14"
                       Foreground="#68717C"
                       Margin="0,3,0,18"/>

            <TextBlock Text="Start, stop and restart the backup components."
                       Foreground="#68717C"
                       Margin="0,0,0,15"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="OverallStatusText"
                       Text="Checking services..."
                       VerticalAlignment="Center"
                       Foreground="#68717C"/>

            <Button Grid.Column="1"
                    Content="Refresh Status"
                    Padding="16,7"
                    Click="RefreshStatus_Click"/>
        </Grid>

        <StackPanel Grid.Row="2">

            <!-- API -->

            <Border BorderBrush="#D8DCE1"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="14"
                    Margin="0,0,0,8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="ApiLed"
                             Width="16"
                             Height="16"
                             Fill="#D62828"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Backup API"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="ErongoIT.Backup.Api"
                                   Foreground="#68717C"/>
                        <TextBlock Text="http://localhost:5230"
                                   Foreground="#68717C"
                                   FontSize="12"/>
                    </StackPanel>

                    <TextBlock x:Name="ApiStatusText"
                               Grid.Column="2"
                               Text="Stopped"
                               VerticalAlignment="Center"
                               Margin="15,0"
                               FontWeight="SemiBold"/>

                    <Button Grid.Column="3"
                            Content="Start"
                            Width="75"
                            Margin="5"
                            Click="ApiStart_Click"/>

                    <Button Grid.Column="4"
                            Content="Stop"
                            Width="75"
                            Margin="5"
                            Click="ApiStop_Click"/>
                </Grid>
            </Border>

            <!-- AGENT -->

            <Border BorderBrush="#D8DCE1"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="14"
                    Margin="0,0,0,8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="AgentLed"
                             Width="16"
                             Height="16"
                             Fill="#D62828"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Backup Agent"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="ErongoIT.Backup.Agent"
                                   Foreground="#68717C"/>
                        <TextBlock Text="Background backup worker"
                                   Foreground="#68717C"
                                   FontSize="12"/>
                    </StackPanel>

                    <TextBlock x:Name="AgentStatusText"
                               Grid.Column="2"
                               Text="Stopped"
                               VerticalAlignment="Center"
                               Margin="15,0"
                               FontWeight="SemiBold"/>

                    <Button Grid.Column="3"
                            Content="Start"
                            Width="75"
                            Margin="5"
                            Click="AgentStart_Click"/>

                    <Button Grid.Column="4"
                            Content="Stop"
                            Width="75"
                            Margin="5"
                            Click="AgentStop_Click"/>
                </Grid>
            </Border>

            <!-- WEB -->

            <Border BorderBrush="#D8DCE1"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="14"
                    Margin="0,0,0,8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="WebLed"
                             Width="16"
                             Height="16"
                             Fill="#D62828"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Backup Web"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="ErongoIT.Backup.Web"
                                   Foreground="#68717C"/>
                        <TextBlock Text="http://localhost:5165"
                                   Foreground="#68717C"
                                   FontSize="12"/>
                    </StackPanel>

                    <TextBlock x:Name="WebStatusText"
                               Grid.Column="2"
                               Text="Stopped"
                               VerticalAlignment="Center"
                               Margin="15,0"
                               FontWeight="SemiBold"/>

                    <Button Grid.Column="3"
                            Content="Start"
                            Width="75"
                            Margin="5"
                            Click="WebStart_Click"/>

                    <Button Grid.Column="4"
                            Content="Stop"
                            Width="75"
                            Margin="5"
                            Click="WebStop_Click"/>
                </Grid>
            </Border>

            <!-- GUI -->

            <Border BorderBrush="#D8DCE1"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="14"
                    Margin="0,10,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="GUI"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Backup Agent GUI"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Manual backup, restore and settings"
                                   Foreground="#68717C"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="Launch GUI"
                            Width="105"
                            Padding="8,6"
                            Click="LaunchGui_Click"/>
                </Grid>
            </Border>

        </StackPanel>

        <TextBlock Grid.Row="3"
                   Text="API should be running before the Agent or Web."
                   Foreground="#68717C"
                   Margin="0,15,0,0"/>

    </Grid>
</Window>
