<Window x:Class="ErongoIT.Backup.ServiceManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ErongoIT Backup - Service Manager"
        Width="780"
        Height="720"
        MinWidth="700"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8DCE1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#68717C"/>
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Led" TargetType="Ellipse">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Fill" Value="#9AA3AD"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="75"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">

        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="ErongoIT Backup"
                           FontSize="26"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Service Manager"
                           FontSize="14"
                           Style="{StaticResource Muted}"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Bottom">
                <Button Content="Refresh"
                        Click="RefreshStatus_Click"/>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <TextBlock x:Name="FooterText"
                   DockPanel.Dock="Bottom"
                   Style="{StaticResource Muted}"
                   FontSize="12"
                   Margin="0,6,0,0"
                   Text="Starting..."/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- CLOUD SERVER -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse x:Name="CloudLed"
                                 Style="{StaticResource Led}"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Cloud Backup Server"
                                       Style="{StaticResource Title}"/>
                            <TextBlock x:Name="CloudUrlText"
                                       Text="https://backup.erongoit.com"
                                       Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="CloudStatusText"
                                       Text="Checking..."
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">
                            <Button Content="Open Portal"
                                    Click="OpenPortal_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- AGENT -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse x:Name="AgentLed"
                                 Style="{StaticResource Led}"/>

                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Backup Agent"
                                           Style="{StaticResource Title}"/>
                                <TextBlock x:Name="AgentStatusText"
                                           Text="Stopped"
                                           FontWeight="SemiBold"
                                           Margin="12,2,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="AgentModeText"
                                       Text="Runs scheduled backups from this PC to the cloud server."
                                       Style="{StaticResource Muted}"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Last seen" Style="{StaticResource Muted}"/>
                                <TextBlock x:Name="LastSeenText" Grid.Column="1" Text="—" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="1" Text="Last backup" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                <TextBlock x:Name="LastBackupText" Grid.Row="1" Grid.Column="1" Text="—" TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <TextBlock Grid.Row="2" Text="Next backup" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                <TextBlock x:Name="NextBackupText" Grid.Row="2" Grid.Column="1" Text="—" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Start"
                                        Click="AgentStart_Click"/>
                                <Button Content="Stop"
                                        Click="AgentStop_Click"/>
                            </StackPanel>
                            <Button Content="View Log"
                                    Click="ViewAgentLog_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- GUI -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="GUI"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Backup GUI"
                                       Style="{StaticResource Title}"/>
                            <TextBlock Text="Back up now, restore files and view history."
                                       Style="{StaticResource Muted}"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="Open Backup GUI"
                                VerticalAlignment="Center"
                                Click="LaunchVpsGui_Click"/>
                    </Grid>
                </Border>

                <!-- DEVELOPER -->
                <Expander Header="Developer (local test environment)"
                          Margin="0,6,0,0">
                    <Border Style="{StaticResource Card}"
                            Margin="0,8,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="35"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse x:Name="ApiLed"
                                         Style="{StaticResource Led}"/>

                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Local API (Docker)"
                                                   Style="{StaticResource Title}"/>
                                        <TextBlock x:Name="ApiStatusText"
                                                   Text="Stopped"
                                                   FontWeight="SemiBold"
                                                   Margin="12,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="http://localhost:5230 — only for testing code before deploying."
                                               Style="{StaticResource Muted}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Content="Start"
                                            Click="ApiStart_Click"/>
                                    <Button Content="Stop"
                                            Click="ApiStop_Click"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="35"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Local GUI"
                                               Style="{StaticResource Title}"/>
                                    <TextBlock Text="Agent GUI connected to the local API."
                                               Style="{StaticResource Muted}"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Content="Launch Local GUI"
                                        VerticalAlignment="Center"
                                        Click="LaunchGui_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
